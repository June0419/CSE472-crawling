      <node id="114027395156775373" label="@ikluft@avgeek.social: @NewtonMark Not necessarily, and not simply because I flew on one. I…">
        <attvalues>
          <attvalue for="0" value="109525810222134461" />
          <attvalue for="1" value="ikluft@avgeek.social" />
          <attvalue for="2" value="2025-02-18T23:06:05.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="@NewtonMark Not necessarily, and not simply because I flew on one. I suppose that scenario was possible, but would have been more likely 10 years earlier. The A380 arrived when twin-engine efficiency and reliability (ETOPS ratings) were already putting economic pressure on quad-jets. A380 arrived on the market too late. The 747 was only able to squeeze out more production after A380 was discontinued because there was a cargo variant, the same way it survived the economic bumps from 1970-2023." />
          <attvalue for="5" value="" />
          <attvalue for="6" value="context_descendants" />
          <attvalue for="7" value="1" />
          <attvalue for="8" value="0" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
          <attvalue for="11" value="0" />
          <attvalue for="12" value="0" />
          <attvalue for="13" value="0" />
          <attvalue for="14" value="0" />
        </attvalues>
      </node>
      <node id="114028258573028557" label="@ikluft@avgeek.social: @NewtonMark All the major US carriers were either in bankruptcy or ne…">
        <attvalues>
          <attvalue for="0" value="109525810222134461" />
          <attvalue for="1" value="ikluft@avgeek.social" />
          <attvalue for="2" value="2025-02-19T02:45:40.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="@NewtonMark All the major US carriers were either in bankruptcy or near it during the years following 2001. A380 orders weren't going to happen. As each recovered, the market turned away from quad-jets and drove their decisions toward twins. Even the 747-8I never found a major US carrier in that period. But the 747-8Fs sold well enough that I regularly see them out my window approaching PDX even when I'm not looking for them. Airbus didn't have an A380 freighter to keep the assembly line going." />
          <attvalue for="5" value="" />
          <attvalue for="6" value="context_descendants" />
          <attvalue for="7" value="0" />
          <attvalue for="8" value="0" />
          <attvalue for="9" value="0" />
          <attvalue for="10" value="1" />
          <attvalue for="11" value="0" />
          <attvalue for="12" value="0" />
          <attvalue for="13" value="0" />
          <attvalue for="14" value="0" />
        </attvalues>
      </node>
