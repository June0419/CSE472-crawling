      <node id="114137074317158961" label="@ikluft@avgeek.social: I posted a YouTube video with narrated photos/videos from my trip to…">
        <attvalues>
          <attvalue for="0" value="109525810222134461" />
          <attvalue for="1" value="ikluft@avgeek.social" />
          <attvalue for="2" value="2025-03-10T07:58:55.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="I posted a YouTube video with narrated photos/videos from my trip to #Australia in late Jan / early Feb 2025. Thanks to friend &amp; colleague @Leighton for acting as my local guide. Among sightseeing spots: Blue Mountains, Sydney Bridge Climb, Australia Day concert &amp; fireworks in Sydney, Australian Parliament House in Canberra, Melbourne CBD, Great Ocean Road &amp; Naracoorte Caves. Also Portland VIC, since I live in Portland OR. https://www.youtube.com/watch?v=6BZrHoR4Dv8 #aviation #travel #roadtrip…" />
          <attvalue for="5" value="australia|aviation|travel|roadtrip|avgeek" />
