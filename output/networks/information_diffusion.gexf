      <node id="113885229090141239" label="@adamasnemesis@social.adamasnemesis.com: I've been of a mind to contribute to the relief effort: it makes me f…">
        <attvalues>
          <attvalue for="0" value="1156890" />
          <attvalue for="1" value="adamasnemesis@social.adamasnemesis.com" />
          <attvalue for="2" value="2025-01-24T20:31:17.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="I've been of a mind to contribute to the relief effort: it makes me feel better than wallowing in a depression at my hotel. But I really wonder if I'm just wasting my time...especially since I have no friends, no family, and only a small amount of money. #disaster #wildfires #CaliforniaFires #PalisadesFire #fires #thoughts #self" />
          <attvalue for="5" value="disaster|wildfires|californiafires|palisadesfire|fires|thoughts|self" />
