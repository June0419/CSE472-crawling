      <data key="d15">2</data>
      <data key="d16">1</data>
      <data key="d17">1</data>
    </node>
    <node id="115369212329293495">
      <data key="d2">@OLjohnel@m.ai6yr.org: @ai6yr @camless They're very attractive places to build, relatively l…</data>
      <data key="d3">109371847891875579</data>
      <data key="d4">OLjohnel@m.ai6yr.org</data>
      <data key="d5">2025-10-13T22:27:49.000Z</data>
      <data key="d6">en</data>
      <data key="d7">@ai6yr @camless They're very attractive places to build, relatively level yet higher than surrounding lowlands, it's too bad they're so dangerous when certain weather and fire history/ground conditions align.</data>
      <data key="d8" />
      <data key="d9">context_descendants</data>
      <data key="d10">1</data>
