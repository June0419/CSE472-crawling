          <attvalue for="10" value="1" />
          <attvalue for="11" value="0" />
          <attvalue for="12" value="2" />
          <attvalue for="13" value="1" />
          <attvalue for="14" value="1" />
        </attvalues>
      </node>
      <node id="113885206093947843" label="@adamasnemesis@social.adamasnemesis.com: You know, online and offline I see so much &quot;thank you, firefighters!&quot;…">
        <attvalues>
          <attvalue for="0" value="1156890" />
          <attvalue for="1" value="adamasnemesis@social.adamasnemesis.com" />
          <attvalue for="2" value="2025-01-24T20:25:25.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="You know, online and offline I see so much &quot;thank you, firefighters!&quot;. Yeah, thank you? For what!? Nobody lifted a finger to help me or gave a damn about me: up until the moment I witnessed the flames and bugged out I saw not a single &quot;first responder&quot; doing a lick of work. #disaster #government #society #wildfires #PalisadesFire #fire #CaliforniaFires #self #thoughts" />
          <attvalue for="5" value="disaster|government|society|wildfires|palisadesfire|fire|californiafires|self|thoughts" />
          <attvalue for="6" value="hashtag_timeline|context_ancestors" />
