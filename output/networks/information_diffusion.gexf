      <node id="114240573039269913" label="@Nonilex@masto.ai: #Crisis On The Coast: #DomoicAcid Poisoning Strands 140 #SeaLions &amp; 5…">
        <attvalues>
          <attvalue for="0" value="109303988606874604" />
          <attvalue for="1" value="Nonilex@masto.ai" />
          <attvalue for="2" value="2025-03-28T14:40:02.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="#Crisis On The Coast: #DomoicAcid Poisoning Strands 140 #SeaLions &amp; 50 #Dolphins On #California Beaches The recent influx of #marine #wildlife affected by domoic acid poisoning off the coast of Southern California underscores a critical #environmental crisis, w/≧140 sea lions suffering from this debilitating poison &amp; reports of at least 50 stranded dolphins along local beaches. #ClimateCrisis #climate #MarineLife #ocean #wildfires #ecosystems #algae #OceanWarming #science https://worldanimalnew…" />
          <attvalue for="5" value="science|crisis|domoicacid|sealions|dolphins|california|marine|wildlife|environmental|climatecrisis|climate|marinelife|ocean|wildfires|ecosystems|algae|oceanwarming" />
