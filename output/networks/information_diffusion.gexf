      <node id="114240644516501747" label="@Nonilex@masto.ai: Recognizing the interconnection of human &amp; #marine #ecosystems is ess…">
        <attvalues>
          <attvalue for="0" value="109303988606874604" />
          <attvalue for="1" value="Nonilex@masto.ai" />
          <attvalue for="2" value="2025-03-28T14:58:14.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="Recognizing the interconnection of human &amp; #marine #ecosystems is essential, as the stress in one often affects the other. If you see a marine mammal in distress, please give them space and call the Marine Mammal Care Center’s Marine Mammal Hotline at 1-800-39-WHALE (94253). #ClimateCrisis #climate #MarineLife #ocean #wildfires #science #wildlife #MarineMammals #SeaLions #Dolphins #California" />
