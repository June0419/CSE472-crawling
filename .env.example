# Mastodon server where you created the API application.
MASTODON_BASE_URL=https://mastodon.social

# Keep the real token only in .env. Never commit it to GitHub.
MASTODON_ACCESS_TOKEN=replace_with_your_access_token

# Project topic and collection inputs.
DISASTER_NAME=replace_with_the_disaster_name
DISASTER_HASHTAGS=hashtag_one,hashtag_two,hashtag_three
SEED_USERS=user_one@instance.example,user_two@instance.example

# Required minimums from the assignment.
TARGET_POST_COUNT=500
TARGET_USER_COUNT=200

# Be polite to the server. Increase this if the server asks you to slow down.
REQUEST_DELAY_SECONDS=0.5
USER_STATUS_PAGES_PER_HASHTAG=2
MAX_CONTEXT_REQUESTS=100
