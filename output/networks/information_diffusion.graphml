      <data key="d15">2</data>
      <data key="d16">1</data>
      <data key="d17">1</data>
    </node>
    <node id="115369501966540606">
      <data key="d2">@camless@m.ai6yr.org: @OLjohnel @ai6yr Yep, we have a State Landslide Inventory Database th…</data>
      <data key="d3">111270616296004000</data>
      <data key="d4">camless@m.ai6yr.org</data>
      <data key="d5">2025-10-13T23:41:32.000Z</data>
      <data key="d6">en</data>
      <data key="d7">@OLjohnel @ai6yr Yep, we have a State Landslide Inventory Database that includes these mapped items as well as our statewide lidar layers. I often don't include the flood zones because many debris fans are well out of the 100 or 500yr zones.</data>
      <data key="d8" />
      <data key="d9">context_descendants</data>
      <data key="d10">0</data>
      <data key="d11">0</data>
      <data key="d12">2</data>
