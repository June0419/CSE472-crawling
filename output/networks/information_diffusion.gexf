      <node id="113885208481149589" label="@adamasnemesis@social.adamasnemesis.com: They literally have done nothing to help me at any stage of the disas…">
        <attvalues>
          <attvalue for="0" value="1156890" />
          <attvalue for="1" value="adamasnemesis@social.adamasnemesis.com" />
          <attvalue for="2" value="2025-01-24T20:25:58.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="They literally have done nothing to help me at any stage of the disaster. Even when I waited in line for hours to get an &quot;escort&quot; to go back to my house it turned out these illustrious &quot;first responders&quot; were fraudsters: there were no escorts. And there still is no access. #disaster #government #society #wildfires #PalisadesFire #fire #CaliforniaFires #self #thoughts" />
          <attvalue for="5" value="society|wildfires|palisadesfire|fire|californiafires|self|thoughts|disaster|government" />
          <attvalue for="6" value="hashtag_timeline" />
          <attvalue for="7" value="1" />
