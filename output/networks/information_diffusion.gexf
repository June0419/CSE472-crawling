      <node id="113953845740541498" label="@ikluft@avgeek.social: I'm safe at home in #Portland #Oregon. So I can declare the trip to #…">
        <attvalues>
          <attvalue for="0" value="109525810222134461" />
          <attvalue for="1" value="ikluft@avgeek.social" />
          <attvalue for="2" value="2025-02-05T23:21:29.000Z" />
          <attvalue for="3" value="en" />
          <attvalue for="4" value="I'm safe at home in #Portland #Oregon. So I can declare the trip to #Australia a complete success. I had a wonderful time and saw so much more than my previous visit. The hot weather was expected since it's summer there. I got to fly for the first time on an A380 outbound and 787 on the return. And from all the likes and boosts it seems a lot of you appreciated that I shared the experience. #aviation #travel #avgeek" />
          <attvalue for="5" value="portland|oregon|australia|aviation|travel|avgeek" />
